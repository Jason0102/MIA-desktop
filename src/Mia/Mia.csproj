<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MIA</AssemblyName>
    <RootNamespace>Mia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.2.0</Version>
    <StartupObject>Mia.App</StartupObject>
    <!-- WPF owns application startup; PerMonitorV2 must live in the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup><Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="role.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
